ENVIRONMENT=development

# Vani — STT (Groq cloud primary)
GROQ_API_KEY=

# Vani - STT local fallback (faster-whisper)
STT_LOCAL_MODEL=small
STT_LOCAL_DEVICE=cpu
STT_LOCAL_COMPUTE_TYPE=int8

# Vani — TTS (edge-tts cloud primary — free, no key needed)
TTS_EDGE_VOICE=en-US-AriaNeural

# Vani — TTS local fallback (Kokoro-ONNX)
# Download kokoro-v1.0.onnx + voices-v1.0.bin from the kokoro-onnx repo
# releases and place them at these paths (not auto-downloaded).
TTS_KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
TTS_KOKORO_VOICES_PATH=models/voices-v1.0.bin
TTS_KOKORO_VOICE=af_sarah
TTS_KOKORO_LANG=en-us
TTS_KOKORO_SPEED=1.0

# Provider fallback/retry tuning (shared by STT and TTS chains)
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=1.5
