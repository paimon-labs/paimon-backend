ENVIRONMENT=development

# Vani — STT (Groq cloud primary)
GROQ_API_KEY=

# Vani - STT local fallback (faster-whisper)
STT_LOCAL_MODEL=small
STT_LOCAL_DEVICE=cpu
STT_LOCAL_COMPUTE_TYPE=int8

# Vani — TTS (edge-tts cloud primary — free, no key needed)
TTS_EDGE_VOICE=en-US-AriaNeural

# Vani — TTS local fallback (Kokoro-ONNX)
# Download kokoro-v1.0.onnx + voices-v1.0.bin from the kokoro-onnx repo
# releases and place them at these paths (not auto-downloaded).
TTS_KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
TTS_KOKORO_VOICES_PATH=models/voices-v1.0.bin
TTS_KOKORO_VOICE=af_sarah
TTS_KOKORO_LANG=en-us
TTS_KOKORO_SPEED=1.0

# Manas — MongoDB Atlas (structured + vector + episodic, one cluster).
# Sakshi's event log lives here too. Free M0 tier is enough to start;
# enable Atlas Vector Search on the cluster from the Atlas UI.
MONGODB_URI=
MONGODB_DB_NAME=paimon

# Narada — LLM provider chain: NVIDIA build (primary) -> Groq -> Gemini
# -> local Ollama (final fallback, not auto-installed — run
# `ollama pull <model>` yourself first).
NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
GROQ_LLM_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2

# Provider fallback/retry tuning (shared by STT, TTS, and LLM chains)
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_SECONDS=1.5
